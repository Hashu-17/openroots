flowchart TD
    subgraph CLIENTS["Clients"]
        DASHBOARD["Web Dashboard"]
        MOBILE["Flutter Mobile App"]
        DEVICES["IoT Devices"]
    end

    subgraph TRANSPORT["Transport Layer"]
        REST["REST Controllers"]
        MQTT_IN["MQTT Listener"]
    end

    AUTH["Authentication"]
    DEVICE["Device Module"]

    subgraph SUBMODULES["Application Modules"]
        TELEMETRY["Telemetry Module"]
        COMMAND["Command Module"]
        ALERT["Alert Module"]
        USER["User Module"]
    end

    DB[("PostgreSQL")]

    DASHBOARD -- HTTPS --> REST
    MOBILE -- HTTPS --> REST
    DEVICES -- MQTT --> MQTT_IN

    REST --> AUTH
    MQTT_IN --> AUTH
    AUTH --> DEVICE
    DEVICE --> TELEMETRY & COMMAND & ALERT & USER
    TELEMETRY & COMMAND & ALERT & USER & DEVICE --> DB

    classDef clients fill:#E6F1FB,stroke:#185FA5,color:#0C447C;
    classDef transport fill:#E1F5EE,stroke:#0F6E56,color:#085041;
    classDef application fill:#EEEDFE,stroke:#534AB7,color:#3C3489;
    classDef storage fill:#FAEEDA,stroke:#854F0B,color:#633806;

    class DASHBOARD,MOBILE,DEVICES clients;
    class REST,MQTT_IN transport;
    class AUTH,DEVICE,TELEMETRY,COMMAND,ALERT,USER application;
    class DB storage;
