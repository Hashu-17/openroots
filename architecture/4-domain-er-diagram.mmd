erDiagram
    USER ||--o{ PROJECT_MEMBER : has
    PROJECT ||--o{ PROJECT_MEMBER : has
    PROJECT ||--o{ DEVICE_GROUP : contains
    PROJECT ||--o{ DEVICE : contains
    DEVICE_GROUP ||--o{ DEVICE : groups
    GATEWAY ||--o{ DEVICE : relays
    DEVICE ||--o{ SENSOR : exposes
    SENSOR ||--o{ TELEMETRY : emits
    DEVICE ||--o{ COMMAND : receives
    DEVICE ||--o{ ALERT : triggers
    FIRMWARE ||--o{ DEVICE : "flashed on"
    ALERT ||--o{ NOTIFICATION : generates
    USER ||--o{ NOTIFICATION : receives

    USER {
        uuid id PK
        string email
        string password_hash
        timestamp created_at
    }
    PROJECT {
        uuid id PK
        string name
        timestamp created_at
    }
    PROJECT_MEMBER {
        uuid id PK
        uuid user_id FK
        uuid project_id FK
        string role
    }
    DEVICE_GROUP {
        uuid id PK
        uuid project_id FK
        string name
    }
    GATEWAY {
        uuid id PK
        string name
        string protocol
    }
    FIRMWARE {
        uuid id PK
        string version
        string binary_url
        timestamp released_at
    }
    DEVICE {
        uuid id PK
        uuid project_id FK
        uuid device_group_id FK
        uuid gateway_id FK
        uuid firmware_id FK
        string name
        string status
        timestamp last_seen_at
    }
    SENSOR {
        uuid id PK
        uuid device_id FK
        string channel_name
        string unit
    }
    TELEMETRY {
        uuid id PK
        uuid sensor_id FK
        double value
        timestamp recorded_at
    }
    COMMAND {
        uuid id PK
        uuid device_id FK
        string type
        string payload
        string status
        timestamp sent_at
    }
    ALERT {
        uuid id PK
        uuid device_id FK
        string rule
        string severity
        timestamp triggered_at
    }
    NOTIFICATION {
        uuid id PK
        uuid alert_id FK
        uuid user_id FK
        string channel
        boolean read
        timestamp sent_at
    }
