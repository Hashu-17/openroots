# Set MQTT_HOST to the server's stable LAN IP.
MQTT_HOST=192.168.1.20
MQTT_PORT=1883

# Copy these three values from the one-time credentials shown after registering
# the device in the OpenRoots site.
MQTT_USERNAME=registered-device-uuid
MQTT_PASSWORD=copy-the-one-time-password-here
MQTT_TOPIC=openroots/v1/devices/registered-device-uuid/telemetry

# Channel names must exactly match sensors registered for this device.
# Send any number of registered channels together in each MQTT message.
TELEMETRY_VALUES_JSON='{"temperature":22.5,"humidity":58}'

# Publish repeatedly for live-view and resource checks; use 5 for a 5-second interval.
PUBLISH_INTERVAL_SECONDS=10
