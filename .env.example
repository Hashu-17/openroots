POSTGRES_DB=iot_backend
POSTGRES_USER=iot_backend
POSTGRES_PASSWORD=change-this-database-password

# Base64 HMAC key for JWT access tokens (32+ bytes). Generate with: openssl rand -base64 48
OPENROOTS_JWT_SECRET=change-this-to-a-random-base64-secret

# First platform administrator, created at startup when no admin exists yet.
# Log in once, then remove the password line from .env.
OPENROOTS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPENROOTS_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

MQTT_ADMIN_USERNAME=openroots-admin
MQTT_ADMIN_PASSWORD=change-this-mqtt-admin-password
MQTT_INGESTOR_USERNAME=telemetry-ingestor
MQTT_INGESTOR_PASSWORD=change-this-mqtt-ingestor-password

# Shared key the Go ingestion service uses to read the device registry from the backend.
# Generate with: openssl rand -base64 32
INGESTION_REGISTRY_API_KEY=change-this-registry-key

# --- Optional ---
# Spring profile. Defaults to prod. Use dev only on a local machine (it seeds a demo account).
# SPRING_PROFILES_ACTIVE=dev
# Interface the MQTT broker listens on. Defaults to 127.0.0.1 (local only).
# MQTT_BIND_ADDRESS=127.0.0.1
# Host ports. Postgres is always bound to 127.0.0.1.
# BACKEND_PORT=8080
# FRONTEND_PORT=5173
# INGESTION_PORT=8081
# POSTGRES_PORT=5432
# MQTT_PORT=1883
