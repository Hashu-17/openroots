POSTGRES_DB=openroots
POSTGRES_USER=openroots
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
SPRING_PROFILES_ACTIVE=dev

# MQTT profile is opt-in: docker compose --profile mqtt up mosquitto
MQTT_PORT=1883
MQTT_DEV_DEVICE_ID=replace-with-registered-lowercase-uuid
MQTT_DEV_DEVICE_PASSWORD=replace-with-long-random-dev-password
MQTT_INGESTOR_PASSWORD=replace-with-long-random-dev-password
