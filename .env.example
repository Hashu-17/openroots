POSTGRES_DB=openroots
POSTGRES_USER=openroots
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
SPRING_PROFILES_ACTIVE=dev

MQTT_PORT=1883
MQTT_ADMIN_USERNAME=openroots-admin
MQTT_ADMIN_PASSWORD=replace-with-long-random-local-admin-password
MQTT_INGESTOR_USERNAME=telemetry-ingestor
MQTT_INGESTOR_PASSWORD=replace-with-long-random-local-ingestor-password

# Shared only between Spring and the Go ingestion container on the Compose network.
INGESTION_REGISTRY_API_KEY=replace-with-long-random-registry-api-key
INGESTION_PORT=8081
INGESTION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
