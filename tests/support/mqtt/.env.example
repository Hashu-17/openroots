# Copy this file to .env for local smoke and load tests.
# Set the smoke-test device values only when running the one-device smoke test.
MQTT_SMOKE_DEVICE_ID= 
MQTT_SMOKE_DEVICE_PASSWORD=
# Shared password for this disposable MQTT load-test fleet.
OPENROOTS_MQTT_DEVICE_PASSWORD=
OPENROOTS_MQTT_HOST=127.0.0.1
OPENROOTS_MQTT_PORT=1883
OPENROOTS_API_URL=http://127.0.0.1:8080
# Test account used to sign in to the API (must be a member of the test project).
# Alternatively set OPENROOTS_API_TOKEN to an existing access token.
OPENROOTS_API_EMAIL=
OPENROOTS_API_PASSWORD=
# Load test only: PostgreSQL DSN used to verify every reading was stored.
# Example: postgresql://iot_backend:PASSWORD@127.0.0.1:5432/iot_backend
OPENROOTS_LOAD_DB_DSN=
MQTT_SMOKE_CHANNEL=temperature
MQTT_SMOKE_TIMEOUT=30
